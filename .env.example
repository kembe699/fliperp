APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# API bearer tokens expire after this many minutes (default 1440 = 24h) so a
# leaked token isn't a permanent credential. See config/sanctum.php.
SANCTUM_EXPIRATION=1440

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# In production, once the Postgres host's TLS support is confirmed:
# DB_SSLMODE=require
# DB_SSLROOTCERT=/path/to/ca.pem   # only needed for verify-full

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb (WebSocket server for notifications + chat). Values below
# are dev placeholders — php artisan reverb:install regenerates real ones,
# or set your own. REVERB_HOST/PORT/SCHEME are what the Reverb server
# itself binds to; the frontend's VITE_REVERB_* vars (see frontend/.env)
# are what the browser connects to and can differ (e.g. behind a proxy).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# In production: set MAIL_MAILER=resend and RESEND_KEY to send purchase
# order / quotation / invoice emails through Resend (config/services.php
# already reads RESEND_KEY). Left as "log" here so local dev never sends a
# real email by accident — mail just gets written to the log instead.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@flippedpos.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# Leave PUBLIC_DISK_DRIVER unset (or "local") for local dev — uploads go to
# storage/app/public as usual. Set to "s3" in production to route the same
# uploads (company logos, employee photos, contract PDFs) through an
# S3-compatible bucket like Cloudflare R2 instead, so they survive redeploys.
# PUBLIC_DISK_DRIVER=s3
# PUBLIC_DISK_URL=https://pub-xxxxxxxx.r2.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
