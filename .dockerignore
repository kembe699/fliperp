# Rebuilt inside the image
node_modules
frontend/node_modules
frontend/dist
vendor
public/build
public/storage

# Secrets and local state — never in an image
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
storage/*.key
storage/app/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
database/*.sqlite

# Not needed at runtime
.git
.github
tests
deploy
ERP.postman_collection.json
*.log
.DS_Store
